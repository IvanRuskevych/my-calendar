{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "main.ts",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "rimraf dist && tsc && tsc-alias",
    "start": "node dist/main.js",
    "serve": "concurrently \"tsc -w\" \"tsc-alias -w\" \"nodemon dist/main.js\"",
    "start:prod": "NODE_ENV=production node dist/main.js"
  },
  "dependencies": {
    "dotenv": "17.2.1",
    "json-server": "0.17.4"
  },
  "devDependencies": {
    "@types/json-server": "^0.14.8",
    "concurrently": "9.2.0",
    "nodemon": "3.1.10",
    "rimraf": "6.0.1",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.20.4"
  }
}
